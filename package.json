{
  "name": "iron-tide",
  "private": true,
  "version": "0.1.1",
  "releaseStage": "BETA",
  "type": "module",
  "description": "MCA: Modern Combined Arms — combined-arms RTS vertical slice",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node tools/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:matchups": "vitest run tests/ai-matchups.test.ts",
    "bench": "vitest run tests/perf.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
