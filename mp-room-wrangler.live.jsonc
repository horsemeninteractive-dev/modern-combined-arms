{
  // Live room worker.
  //
  // Same worker, same Durable Object namespace as the staging config: this file
  // changes configuration, not code. It exists because development mode must
  // never be on in the deployment the public plays on — `MP_DEV_MODE=1` admits
  // any loopback origin and exposes the developer client at
  // `/api/multiplayer/dev`, neither of which belongs in a live runtime.
  //
  // Deploy with `npm run rooms:deploy`. Local development keeps using
  // `mp-room-wrangler.jsonc` through `npm run rooms:dev`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mca-multiplayer-staging",
  "main": "dist-mp-room/roomWorker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "MP_ONLINE_ENABLED": "1",
    "MP_DEFAULT_MATCH_SECONDS": "60",
    "MP_MAX_MATCH_SECONDS": "1800",
    "MP_ABANDON_AFTER_MS": "30000",
    // The live Pages app, its per-deployment preview hosts, and this worker's
    // own origin. One label of wildcard is allowed, so a preview build can be
    // played before it is promoted; the worker refuses any other Origin on both
    // the HTTP surface and the seat socket upgrade.
    "MP_ALLOWED_ORIGINS": "https://mca-multiplayer-staging.horsemeninteractive.workers.dev,https://moderncombinedarms.pages.dev,https://*.moderncombinedarms.pages.dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "MatchRoomDurableObject"
      },
      {
        "name": "CAPACITY",
        "class_name": "CapacityCoordinatorDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MatchRoomDurableObject", "CapacityCoordinatorDurableObject"]
    }
  ]
}
