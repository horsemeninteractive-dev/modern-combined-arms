{
  // Development account Worker.
  //
  // `npm run accounts:dev` runs this locally with a local D1 database; the Vite
  // dev server proxies `/api/account` here, so cookies stay first-party on
  // 127.0.0.1 exactly as they are on the Pages origin in production.
  //
  // No secret is committed. Local runs read `.dev.vars` (gitignored), which
  // overrides these vars: it points APP_ORIGIN at `npm run dev:accounts`
  // (127.0.0.1:5180) and holds the local OAuth client pairs. A real sign-in
  // needs real credentials, which are set with `wrangler secret put` in
  // production.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mca-accounts-staging",
  "main": "dist-account/accountWorker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ACCOUNT_DEV_MODE": "1",
    "APP_ORIGIN": "http://127.0.0.1:5173",
    // The Worker's own hostname is not an app origin; it is listed so a direct
    // diagnostic GET to /api/account/health is not rejected by host checking.
    "ALLOWED_ORIGINS": "http://127.0.0.1:5173,http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mca-accounts",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
